{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ashesborn-blog",
  "main": "worker.js",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": ["/blog/*", "/api/*", "/podcast/rss", "/podcast-media/*", "/photos/*"]
  },
  "routes": [
    {
      "pattern": "blog.ashesborn.cloud/*",
      "zone_name": "ashesborn.cloud"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PODCASTS",
      "bucket_name": "ashesborn-podcasts"
    },
    {
      "binding": "PHOTOS",
      "bucket_name": "ashesborn-photos"
    }
  ],
  // Hyperdrive is created against a Postgres instance that must exist first:
  //   npx wrangler hyperdrive create blog-db --connection-string="postgres://…"
  // then uncomment the block below with the printed id. Until then the Worker
  // deploys fine and the photo/podcast APIs answer 503 ("Database is not
  // configured") instead of taking the whole site down.
  // "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "<config id>" }]
}
