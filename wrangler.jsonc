{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ashesborn-blog",
  "main": "worker.js",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": ["/blog/*", "/api/*", "/podcast/rss", "/podcast-media/*", "/photos/*"]
  },
  "routes": [
    {
      "pattern": "blog.ashesborn.cloud/*",
      "zone_name": "ashesborn.cloud"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PODCASTS",
      "bucket_name": "ashesborn-podcasts"
    },
    {
      "binding": "PHOTOS",
      "bucket_name": "ashesborn-photos"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "REPLACE_WITH_HYPERDRIVE_CONFIG_ID"
    }
  ]
}
