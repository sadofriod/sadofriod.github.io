{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ashesborn-blog",
  "main": "worker.js",
  "compatibility_date": "2026-10-09",
  // Cloudflare Access gate for /photography/upload, /podcast/upload and /api/admin/*.
  // Both must be set for Access to take over; without them the legacy UPLOAD_AUTH_KEY
  // path stays active. Fill these in after creating the Access application (see
  // CLOUDFLARE_DEPLOYMENT.md), then `wrangler deploy`.
  // "vars": {
  //   "ACCESS_TEAM_DOMAIN": "<team>.cloudflareaccess.com",
  //   "ACCESS_AUD": "<application audience tag>"
  // },
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/blog/*", "/api/*", "/podcast/rss", "/podcast-media/*", "/photos/*"]
  },
  "routes": [
    {
      "pattern": "blog.ashesborn.cloud/*",
      "zone_name": "ashesborn.cloud"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PODCASTS",
      "bucket_name": "ashesborn-podcasts"
    },
    {
      "binding": "PHOTOS",
      "bucket_name": "ashesborn-photos"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ashesborn-blog",
      "database_id": "507abc83-44bf-41db-b238-34d7fa17b202"
    }
  ]
}
