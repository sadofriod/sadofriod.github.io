{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ashesborn-blog",
  "main": "worker.js",
  "compatibility_date": "2026-10-09",
  // Cloudflare Access gate for /photography/upload, /podcast/upload and /api/admin/*.
  // The AUD below is the audience tag of the "blog admin" Access application; both values
  // must be present for Access to take over, otherwise the legacy UPLOAD_AUTH_KEY path
  // stays active. See CLOUDFLARE_DEPLOYMENT.md.
  "vars": {
    "ACCESS_TEAM_DOMAIN": "ssh-ashes.cloudflareaccess.com",
    "ACCESS_AUD": "00ccd58cb8be64385e15690089c23882b43ffe7a23471e64afa10f73320510c2"
  },
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/blog/*", "/api/*", "/podcast/rss", "/podcast-media/*", "/photos/*", "/photography", "/photography/*", "/sitemap-photos.xml"]
  },
  "routes": [
    {
      "pattern": "blog.ashesborn.cloud/*",
      "zone_name": "ashesborn.cloud"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PODCASTS",
      "bucket_name": "ashesborn-podcasts"
    },
    {
      "binding": "PHOTOS",
      "bucket_name": "ashesborn-photos"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ashesborn-blog",
      "database_id": "507abc83-44bf-41db-b238-34d7fa17b202"
    }
  ]
}
