{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ashesborn-blog",
  "main": "worker.js",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/blog/*", "/api/*", "/podcast/rss", "/podcast-media/*", "/photos/*"]
  },
  "routes": [
    {
      "pattern": "blog.ashesborn.cloud/*",
      "zone_name": "ashesborn.cloud"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PODCASTS",
      "bucket_name": "ashesborn-podcasts"
    },
    {
      "binding": "PHOTOS",
      "bucket_name": "ashesborn-photos"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ashesborn-blog",
      "database_id": "507abc83-44bf-41db-b238-34d7fa17b202"
    }
  ]
}
